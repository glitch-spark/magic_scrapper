# Copy this file to .env and fill in your values
# For Gmail: use an App Password (not your account password)
# Generate one at: https://myaccount.google.com/apppasswords

EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Adzuna API — register free at developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Ollama Cloud — required when config.py OLLAMA_MODE = "cloud"
# Create a key at: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# FlexJobs (optional, opt-in: python run_pipeline.py fetch --source flexjobs)
FLEXJOBS_EMAIL=
FLEXJOBS_PASSWORD=

# Work at a Startup (optional). When set, --source waas logs in and crawls
# the full-time remote engineering directory. Also accepted: YC_EMAIL / YC_PASSWORD.
WAAS_EMAIL=
WAAS_PASSWORD=

# RemoteYeah apply-URL capture (optional). Dedicated OS Chrome
# user-data-dir already logged into remoteyeah.com.
# Close Chrome if this folder is locked. Headed by default.
# Unset = store RemoteYeah listing-page URLs.
REMOTEYEAH_CHROME_USER_DATA=
# REMOTEYEAH_CHROME_PROFILE=Default
# REMOTEYEAH_HEADLESS=0

# BuiltIn final Apply link only. Listing pages stay on HTTP.
# Log in to builtin.com once in the visible window. Cookies stay in this profile.
# Set CLOAKBROWSER_HEADLESS=1 on the live machine to hide the window.
# Optional proxy for that browser only (listings stay on direct HTTP).
# http://user:pass@host:port or socks5://user:pass@host:port
# Use the same profile directory there. Unset uses .cloak-builtin in the project.
# CLOAKBROWSER_USER_DATA=
# CLOAKBROWSER_HEADLESS=0
# CLOAKBROWSER_PROXY=

# Optional. Each job saved during fetch is upserted here with the scrape
# fields only (identity, title, location, description, url, dates, status).
# Unset keeps SQLite only.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=job_apply_agent
# MONGODB_JOBS_COLLECTION=jobs

# Optional administrator alerts. Only a finished scrape (INFO) and an
# incident that needs you (NEED ACTION) are sent. Skipped pages and
# database locks stay in the log. Each incident is sent once per run.
# Set ALERT_CHANNELS to turn delivery on. A listed channel is skipped
# when its credentials are empty.
# Email uses EMAIL_FROM / EMAIL_PASSWORD above. Add a channel in
# utils/alerts.py by appending one entry to _CHANNELS.
# ALERT_CHANNELS=email,slack,telegram
# ALERT_EMAIL_TO=you@gmail.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
